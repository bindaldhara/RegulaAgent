# Copy to the VM as /etc/regula/voice.env (chmod 600). Do not commit real values.

PORT=8080
REGULA_BACKEND_URL=https://regula-agent-api.onrender.com
OTEL_SDK_DISABLED=true

LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=regula-voice

GROQ_API_KEY=
VOICE_AUDIO_MODE=free
VOICE_GROQ_STT_MODEL=whisper-large-v3-turbo
VOICE_EDGE_TTS_VOICE=en-US-JennyNeural

# Optional: skip Silero ONNX on 1GB VMs (see docs/gcp-voice-worker.md)
# VOICE_TURN_DETECTION=stt
