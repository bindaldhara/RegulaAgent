# mock | openrouter
# mock = regex (tests/CI); openrouter = always LLM; auto = LLM when OPENROUTER_API_KEY is set
AGENT_PROVIDER=auto

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-project-settings

# Supabase Postgres — Project Settings → Database → Connection string
# If your DB password contains +, @, /, or other special characters, do NOT paste the raw URI here.
# Either URL-encode the password in DATABASE_URL, or (recommended) comment DATABASE_URL out and set:
POSTGRES_HOST=aws-0-ap-southeast-2.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.YOUR_PROJECT_REF
POSTGRES_PASSWORD=your-database-password-as-shown-in-dashboard
# DATABASE_URL=postgresql://...



# Frontend (Vite) — same project, anon public key
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# LiveKit voice — https://cloud.livekit.io (optional)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=regula-voice
# Voice worker — default free stack (see docs/voice.md)
VOICE_AUDIO_MODE=free
GROQ_API_KEY=                # Free STT: https://console.groq.com → API Keys
# Groq STT (distil-whisper-large-v3-en was decommissioned — use turbo or large-v3)
VOICE_GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional voice latency tuning
# VOICE_FILLER=One moment.
# VOICE_TTS_MAX_CHARS=1200
# VOICE_HISTORY_TURNS=8
VOICE_EDGE_TTS_VOICE=en-US-JennyNeural
# Paid/alternate modes: VOICE_AUDIO_MODE=openai|openrouter|livekit
VOICE_OPENAI_API_KEY=
OPENAI_API_KEY=

# OpenRouter — https://openrouter.ai/keys (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:5173

# Optional local Postgres (docker compose --profile local)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=regula_agent
POSTGRES_USER=regula
POSTGRES_PASSWORD=regula
